# deploy/docker/.env.example
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to deploy/docker/.env and fill in values before running:
#   cp deploy/docker/.env.example deploy/docker/.env
#   docker compose -f deploy/docker/docker-compose.yml up
#
# The .env file is gitignored and will never be committed.
# ─────────────────────────────────────────────────────────────────────────────


# ── REQUIRED ─────────────────────────────────────────────────────────────────

# API key that clients must send as: Authorization: Bearer <key>
# The container binds 0.0.0.0, so an API key is MANDATORY.
# Compose refuses to start if this is unset.
# Generate one locally with:  jarvis auth generate-key
OPENJARVIS_API_KEY=


# ── INFERENCE ENGINE ─────────────────────────────────────────────────────────

# Which inference engine to use by default.
# Options: ollama (default), vllm, litellm, openai, anthropic, google
OPENJARVIS_ENGINE_DEFAULT=ollama

# The model tag Ollama should use.
# Must already be pulled inside the Ollama container or volume:
#   docker exec -it <ollama-container> ollama pull qwen3.5:4b
OLLAMA_MODEL=qwen3.5:4b

# URL where the OpenJarvis backend reaches Ollama.
# - When using docker-compose.yml (Ollama as a service): http://ollama:11434
# - When Ollama runs on the host machine:                 http://host.docker.internal:11434
OLLAMA_HOST=http://ollama:11434


# ── OPTIONAL: FRONTEND / LEADERBOARD ────────────────────────────────────────

# Public Supabase anon key for the savings leaderboard feature.
# Leave empty to disable the leaderboard (default).
# Passed as a Docker build argument: --build-arg OPENJARVIS_LEADERBOARD_PUBLIC_ANON=<key>
OPENJARVIS_LEADERBOARD_PUBLIC_ANON=


# ── OPTIONAL: LOCAL FRONTEND DEV ────────────────────────────────────────────

# Override the backend URL the Vite dev server proxies to.
# Only relevant when running `npm run dev` outside Docker.
# Default: http://127.0.0.1:8000
VITE_API_URL=http://127.0.0.1:8000


# ── OPTIONAL: CLOUD ENGINE API KEYS ─────────────────────────────────────────
# Only needed if OPENJARVIS_ENGINE_DEFAULT is set to a cloud provider.

# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
